# Event Analysis
EVENTMANAGEMENT_API_URL=http://event-management-svc:8080
MQTT_BROKER_URL=tcp://mosquitto-svc:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Probes Filtering
EVENTANALYSIS_PROBE_THRESHOLD_RSSI=-100
EVENTANALYSIS_ANALYSIS_WINDOWS_SIZE=60
EVENTANALYSIS_ANALYSIS_SLIDE_STEP=15
EVENTANALYSIS_ANALYSIS_MEAN=25
EVENTANALYSIS_ANALYSIS_TREND_HIGHLY_ANGLE=2.5
EVENTANALYSIS_ANALYSIS_TREND_MAX_STABLE_ANGLE=1.0

# Event Management - PostGIS
POSTGRES_URL=jdbc:postgresql://postgis-svc:5432/event_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Event Management
EVENTMANAGEMENT_ANALYSIS_CRITICAL_THRESHOLD=0.8
EVENTMANAGEMENT_ANALYSIS_HIGH_THRESHOLD=0.6
EVENTMANAGEMENT_ANALYSIS_MEDIUM_THRESHOLD=0.4

# Simulator Parameter
SIM_N_PEOPLE=5000

# Prediction Config
EVENTMANAGEMENT_ANALYSIS_PREDICTION_HORIZON_MINUTES=2
EVENTMANAGEMENT_ANALYSIS_PREDICTION_WINDOW_MINUTES=2

# Proxy Target per il frontend Vite
VITE_PROXY_TARGET=http://127.0.0.1:8080

SIM_BACKEND_URL=http://127.0.0.1:8080
API_URL=http://localhost:8080/api